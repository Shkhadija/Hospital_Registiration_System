@page
@model HospitalRegistrationSystem.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Patients";
}

<section class="py-5">
    <div class="container">

        <!-- Page Header -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
            <div>
                <h1 class="display-5 fw-bold mb-2">👥 Patients</h1>
                <p class="text-muted mb-0">
                    View, search and manage all registered patients.
                </p>
            </div>

            <a asp-page="Create" class="btn btn-primary btn-lg rounded-pill shadow-sm px-4">
                ➕ Add New Patient
            </a>
        </div>

        <!-- Stats -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm rounded-4 text-center p-4">
                    <h2 class="fw-bold text-primary mb-1">@Model.Patients.Count</h2>
                    <p class="text-muted mb-0">Total Patients</p>
                </div>
            </div>
        </div>

        <!-- Search Box -->
        <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
            <form method="get">
                <div class="row g-3">
                    <div class="col-md-10">
                        <input type="text"
                               name="SearchTerm"
                               value="@Model.SearchTerm"
                               class="form-control form-control-lg rounded-pill px-4"
                               placeholder="🔍 Search by patient name, phone or email..." />
                    </div>
                    <div class="col-md-2 d-grid">
                        <button type="submit"
                                class="btn btn-outline-primary btn-lg rounded-pill">
                            Search
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <!-- Patients Table -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th>Patient</th>
                            <th>Contact</th>
                            <th>Date of Birth</th>
                            <th>Gender</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Patients.Any())
                        {
                            @foreach (var patient in Model.Patients)
                            {
                                <tr>
                                    <!-- Patient Name -->
                                    <td>
                                        <div class="fw-bold">@patient.FullName</div>
                                    </td>

                                    <!-- Contact -->
                                    <td>
                                        <div>@patient.Phone</div>
                                    </td>

                                    <!-- DOB -->
                                    <td>
                                        @patient.BirthDate.ToString("dd.MM.yyyy")
                                    </td>

                                    <!-- Gender -->
                                    <td>
                                        <span class="badge bg-info text-dark rounded-pill px-3 py-2">
                                            @patient.Gender
                                        </span>
                                    </td>

                                    <!-- Actions -->
                                    <td>
                                        <div class="d-flex justify-content-center gap-1">
                                            <a asp-page="Details"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-info rounded-pill px-3">
                                                <i class="fa-solid fa-eye me-1"></i> Details
                                            </a>

                                            <a asp-page="Edit"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-warning rounded-pill px-3">
                                                <i class="fa-solid fa-pen me-1"></i> Edit
                                            </a>

                                            <a asp-page="Delete"
                                               asp-route-id="@patient.Id"
                                               class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fa-solid fa-trash me-1"></i> Delete
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <div class="text-muted">
                                        <h5>No patients found</h5>
                                        <p class="mb-0">
                                            Add a new patient or try another search term.
                                        </p>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</section>