@page "{id:int}"
@model HospitalRegistrationSystem.Pages.Patients.DeleteModel

@{
    ViewData["Title"] = "Delete Patient";
}

<section class="py-5">
    <div class="container">

        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="display-5 fw-bold text-danger">🗑 Delete Patient</h1>
                <p class="text-muted mb-0">
                    Are you sure you want to delete this patient?
                </p>
            </div>

            <a asp-page="Index"
               class="btn btn-outline-secondary btn-lg rounded-pill px-4">
                ← Back to Patients
            </a>
        </div>

        <!-- Confirmation Card -->
        <div class="card border-0 shadow-lg rounded-4">
            <div class="card-body p-5">

                <div class="alert alert-warning">
                    <strong>Warning:</strong>
                    This action cannot be undone.
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Full Name</dt>
                    <dd class="col-sm-9">@Model.Patient.FullName</dd>

                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@Model.Patient.Phone</dd>

                    <dt class="col-sm-3">Email</dt>
                    <dd class="col-sm-9">@Model.Patient.Email</dd>

                    <dt class="col-sm-3">Gender</dt>
                    <dd class="col-sm-9">@Model.Patient.Gender</dd>
                </dl>

                <form method="post">
                    <input type="hidden" asp-for="Patient.Id" />

                    <div class="mt-4 d-flex gap-3">
                        <button type="submit"
                                class="btn btn-danger btn-lg rounded-pill px-5">
                            🗑 Delete
                        </button>

                        <a asp-page="Index"
                           class="btn btn-outline-secondary btn-lg rounded-pill px-5">
                            Cancel
                        </a>
                    </div>
                </form>

            </div>
        </div>

    </div>
</section>