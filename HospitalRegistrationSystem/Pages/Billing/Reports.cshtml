@page
@model HospitalRegistrationSystem.Pages.Billing.ReportsModel

@{
    ViewData["Title"] = "Billing & Reports";
}

<div class="container mt-4">

    <h1 class="fw-bold mb-2">💳 Billing & Reports</h1>
    <p class="text-muted mb-4">Manage invoices, payments, and financial reports.</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <div class="text-muted small mb-1">Total Invoices</div>
                <div class="fs-2 fw-bold">@Model.TotalInvoices</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <div class="text-muted small mb-1">Paid</div>
                <div class="fs-2 fw-bold text-success">@Model.PaidInvoices</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <div class="text-muted small mb-1">Unpaid</div>
                <div class="fs-2 fw-bold text-warning">@Model.PendingInvoices</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm border-0 rounded-4 text-center p-3">
                <div class="text-muted small mb-1">Total Revenue</div>
                <div class="fs-2 fw-bold text-primary">@Model.TotalRevenue.ToString("0.00") ₼</div>
            </div>
        </div>
    </div>

    <!-- Invoices Table -->
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">
            <h4 class="fw-bold mb-3">📄 Invoices</h4>

            @if (Model.Invoices.Any())
            {
                <!-- Search -->
                <div class="mb-3">
                    <input type="text" id="invoiceSearch" class="form-control"
                           placeholder="🔍 Search by patient or invoice number..." />
                </div>

                <div class="table-responsive">
                    <table class="table align-middle table-hover" id="invoiceTable">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice No</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Amount</th>
                                <th>Method</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in Model.Invoices)
                            {
                                <tr>
                                    <td><code>@invoice.InvoiceNumber</code></td>
                                    <td class="fw-semibold">@invoice.Patient?.FullName</td>
                                    <td class="text-muted">@(invoice.Appointment?.Doctor?.FullName ?? "—")</td>
                                    <td>@invoice.CreatedAt.ToString("dd.MM.yyyy")</td>
                                    <td><strong>@invoice.TotalAmount.ToString("0.00") ₼</strong></td>
                                    <td>
                                        <span class="badge bg-secondary">@invoice.PaymentMethod</span>
                                    </td>
                                    <td>
                                        @if (invoice.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success px-3 py-2">✓ Paid</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark px-3 py-2">Unpaid</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            <!-- Mark as Paid -->
                                            @if (invoice.PaymentStatus == "Unpaid")
                                            {
                                                <a asp-page="/Billing/MarkAsPaid"
                                                   asp-route-id="@invoice.Id"
                                                   class="btn btn-sm btn-success rounded-pill">
                                                    ✓ Paid
                                                </a>
                                            }

                                            <!-- Edit Fee -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary rounded-pill"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editFeeModal"
                                                    data-id="@invoice.Id"
                                                    data-num="@invoice.InvoiceNumber"
                                                    data-consultation="@invoice.ConsultationFee"
                                                    data-service="@invoice.ServiceFee"
                                                    data-discount="@invoice.InsuranceDiscount"
                                                    data-method="@invoice.PaymentMethod">
                                                ✏️ Edit
                                            </button>

                                            <!-- Delete -->
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger rounded-pill"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteInvModal"
                                                    data-id="@invoice.Id"
                                                    data-num="@invoice.InvoiceNumber">
                                                🗑️
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info rounded-4 mb-0">
                    <strong>No invoices yet.</strong>
                    Invoices are created automatically when an appointment status is changed to <strong>Confirmed</strong>.
                </div>
            }
        </div>
    </div>
</div>

<!-- Edit Fee Modal -->
<div class="modal fade" id="editFeeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">✏️ Edit Invoice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="UpdateFee">
                <div class="modal-body">
                    <p class="text-muted small mb-3">Invoice: <strong id="editInvNum"></strong></p>
                    <input type="hidden" name="invoiceId" id="editInvId" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Consultation Fee (₼)</label>
                        <input type="number" step="0.01" min="0" name="consultationFee"
                               id="editConsultation" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Service Fee (₼)</label>
                        <input type="number" step="0.01" min="0" name="serviceFee"
                               id="editService" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Insurance Discount (₼)</label>
                        <input type="number" step="0.01" min="0" name="insuranceDiscount"
                               id="editDiscount" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Payment Method</label>
                        <select name="paymentMethod" class="form-select" id="editMethod">
                            <option value="Cash">Cash</option>
                            <option value="Card">Card</option>
                            <option value="Insurance">Insurance</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete Invoice Modal -->
<div class="modal fade" id="deleteInvModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger">🗑️ Delete Invoice</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Delete invoice <strong id="deleteInvNum"></strong>? This cannot be undone.</p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="invoiceId" id="deleteInvId" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Edit modal
        document.getElementById('editFeeModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('editInvId').value = btn.dataset.id;
            document.getElementById('editInvNum').textContent = btn.dataset.num;
            document.getElementById('editConsultation').value = btn.dataset.consultation;
            document.getElementById('editService').value = btn.dataset.service;
            document.getElementById('editDiscount').value = btn.dataset.discount;
            document.getElementById('editMethod').value = btn.dataset.method;
        });

        // Delete modal
        document.getElementById('deleteInvModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('deleteInvId').value = btn.dataset.id;
            document.getElementById('deleteInvNum').textContent = btn.dataset.num;
        });

        // Search
        document.getElementById('invoiceSearch')?.addEventListener('input', function () {
            var filter = this.value.toLowerCase();
            document.querySelectorAll('#invoiceTable tbody tr').forEach(function (row) {
                row.style.display = row.textContent.toLowerCase().includes(filter) ? '' : 'none';
            });
        });
    </script>
}
