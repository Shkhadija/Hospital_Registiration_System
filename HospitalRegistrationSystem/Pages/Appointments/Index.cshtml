@page
@model HospitalRegistrationSystem.Pages.Appointments.IndexModel

@{
    ViewData["Title"] = "Appointments & Queue";
}

<div class="container mt-4">

    <!-- Başlıq -->
    <div class="mb-4">
        <h1 class="fw-bold">📅 Appointments & Queue</h1>
        <p class="text-muted">
            Manage all appointments and patient queue.
        </p>
    </div>

    @if (Model.Appointments.Any())
    {
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table align-middle table-hover">
                        <thead>
                            <tr>
                                <th>Queue</th>
                                <th>Patient</th>
                                <th>Doctor</th>
                                <th>Date</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.Appointments)
                            {
                                <tr>
                                    <!-- Queue -->
                                    <td>
                                        <span class="badge bg-dark">
                                            #@appointment.QueueNumber
                                        </span>
                                    </td>

                                    <!-- Patient -->
                                    <td>
                                        @appointment.Patient?.FullName
                                    </td>

                                    <!-- Doctor -->
                                    <td>
                                        @appointment.Doctor?.FullName
                                    </td>

                                    <!-- Date -->
                                    <td>
                                        @appointment.AppointmentDate.ToString("dd.MM.yyyy HH:mm")
                                    </td>

                                   
                                    <!-- Status -->
                                    <td>
                                        <span class="badge
                                                    @(appointment.Status == "Pending" ? "bg-warning text-dark" :
                                                                                            appointment.Status == "Confirmed" ? "bg-success" :
                                                                                            appointment.Status == "Completed" ? "bg-primary" :
                                                                                            appointment.Status == "Cancelled" ? "bg-danger" :
                                                                                            "bg-secondary")">
                                    @appointment.Status
                                </span>
                            </td>

                                    <!-- Action -->
                                    <td class="text-center">
                                        <a asp-page="Manage"
                                           asp-route-id="@appointment.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            Manage
                                        </a>
                                    </td>
                                </tr>
                                                }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info rounded-4">
            No appointments found.
        </div>
    }

</div>