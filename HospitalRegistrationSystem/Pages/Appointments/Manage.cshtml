@page "{id:int}"
@model HospitalRegistrationSystem.Pages.Appointments.ManageModel

@{
    ViewData["Title"] = "Manage Appointment";
}

<div class="container mt-4">

    <!-- Başlıq -->
    <div class="mb-4">
        <h1 class="fw-bold">🛠 Manage Appointment</h1>
        <p class="text-muted">
            Update appointment status and notes.
        </p>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">

            <form method="post">

                <input type="hidden" asp-for="Appointment.Id" />

                <!-- Patient -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Patient</label>
                    <input class="form-control"
                           value="@Model.Appointment.Patient?.FullName"
                           readonly />
                </div>

                <!-- Doctor -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Doctor</label>
                    <input class="form-control"
                           value="@Model.Appointment.Doctor?.FullName"
                           readonly />
                </div>

                <!-- Appointment Date -->
                <div class="mb-3">
                    <label class="form-label fw-semibold">Appointment Date</label>
                    <input class="form-control"
                           value="@Model.Appointment.AppointmentDate.ToString("dd.MM.yyyy HH:mm")"
                           readonly />
                </div>

                <!-- Status -->
                <div class="mb-3">
                    <label asp-for="Appointment.Status"
                           class="form-label fw-semibold">
                        Status
                    </label>

                    <select asp-for="Appointment.Status"
                            asp-items="Model.StatusOptions"
                            class="form-select">
                    </select>
                </div>

                <!-- Notes -->
                <div class="mb-3">
                    <label asp-for="Appointment.Notes"
                           class="form-label fw-semibold">
                        Notes
                    </label>

                    <textarea asp-for="Appointment.Notes"
                              class="form-control"
                              rows="4"></textarea>
                </div>

                <!-- Buttons -->
                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary px-4">
                        Save Changes
                    </button>

                    <a asp-page="Index"
                       class="btn btn-outline-secondary">
                        Back
                    </a>
                </div>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}