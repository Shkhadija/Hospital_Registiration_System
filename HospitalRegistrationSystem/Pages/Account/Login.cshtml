@page
@model HospitalRegistrationSystem.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-body p-5">

                <!-- Başlıq -->
                <div class="text-center mb-4">
                    <h2 class="fw-bold text-primary">🏥 MediCore Hospital</h2>
                    <p class="text-muted">Sign in to your account</p>
                </div>

                <!-- Ümumi xəta mesajları -->
                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <form method="post">

                    <!-- Username -->
                    <div class="mb-3">
                        <label asp-for="Input.Username"
                               class="form-label">
                            Username
                        </label>
                        <input asp-for="Input.Username"
                               class="form-control"
                               placeholder="Enter username" />
                        <span asp-validation-for="Input.Username"
                              class="text-danger"></span>
                    </div>

                    <!-- Password -->
                    <div class="mb-3">
                        <label asp-for="Input.Password"
                               class="form-label">
                            Password
                        </label>
                        <input asp-for="Input.Password"
                               class="form-control"
                               type="password"
                               placeholder="Enter password" />
                        <span asp-validation-for="Input.Password"
                              class="text-danger"></span>
                    </div>

                    <!-- Remember Me -->
                    <div class="form-check mb-3">
                        <input asp-for="Input.RememberMe"
                               class="form-check-input" />
                        <label asp-for="Input.RememberMe"
                               class="form-check-label">
                            Remember Me
                        </label>
                    </div>

                    <!-- Login Button -->
                    <button type="submit"
                            class="btn btn-primary w-100 py-2">
                        Login
                    </button>
                </form>

                <!-- Register linki -->
                <div class="text-center mt-3">
                    <span class="text-muted">
                        Don't have an account?
                    </span>
                    <a asp-page="/Account/Register"
                       class="fw-bold text-decoration-none">
                        Register
                    </a>
                </div>

                <!-- Demo login məlumatları -->
                <div class="alert alert-info mt-4 mb-0">
                    <strong>Demo Login:</strong><br />
                    Username: <code>admin</code><br />
                    Password: <code>123456</code>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}