@page
@model HospitalRegistrationSystem.Pages.IndexModel

@{
    ViewData["Title"] = "MediCore Hospital";
}

<link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />

<!-- ================= HERO SECTION ================= -->
<section class="premium-hero position-relative overflow-hidden">
    <div class="hero-bg-shape shape-1"></div>
    <div class="hero-bg-shape shape-2"></div>
    <div class="hero-bg-shape shape-3"></div>

    <div class="container py-5">
        <div class="row align-items-center min-vh-100">

            <!-- LEFT CONTENT -->
            <div class="col-lg-6 text-white" data-aos="fade-right">

                <span class="hero-badge">
                    🏥 Trusted Healthcare Since 2005
                </span>

                <h1 class="hero-title mt-4">
                    Your Health,
                    <span>Our Priority</span>
                </h1>

                <p class="hero-description mt-4">
                    Book appointments with expert doctors, access medical records,
                    and receive world-class healthcare services.
                </p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a asp-page="/Doctors/Index" class="btn btn-glow">
                        👨‍⚕️ Find Doctors
                    </a>

                    <a asp-page="/Account/Login" class="btn btn-outline-premium">
                        🔐 Sign In
                    </a>
                </div>

                <!-- STATS -->
                <div class="row g-3 mt-5">

                    <div class="col-4">
                        <div class="stat-card glass-card">
                            <h3 class="counter" data-target="50">0</h3>
                            <p>Specialist Doctors</p>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="stat-card glass-card">
                            <h3 class="counter" data-target="10000">0</h3>
                            <p>Happy Patients</p>
                        </div>
                    </div>

                    <div class="col-4">
                        <div class="stat-card glass-card">
                            <h3 class="counter" data-target="24">0</h3>
                            <p>Emergency Service</p>
                        </div>
                    </div>

                </div>
            </div>

            <!-- RIGHT VISUAL -->
            <div class="col-lg-6 mt-5 mt-lg-0" data-aos="fade-left">
                <div class="hero-slider-container">

                    <div id="heroSlider" class="carousel slide carousel-fade"
                         data-bs-ride="carousel"
                         data-bs-interval="4000">

                        <!-- Indicators -->
                        <div class="carousel-indicators">
                            <button type="button"
                                    data-bs-target="#heroSlider"
                                    data-bs-slide-to="0"
                                    class="active"></button>

                            <button type="button"
                                    data-bs-target="#heroSlider"
                                    data-bs-slide-to="1"></button>

                            <button type="button"
                                    data-bs-target="#heroSlider"
                                    data-bs-slide-to="2"></button>
                        </div>

                        <!-- Slides -->
                        <div class="carousel-inner rounded-5 shadow-lg">

                            <!-- Slide 1 -->
                            <div class="carousel-item active">
                                <img src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=900&q=80"
                                     class="d-block w-100 hero-slide-img"
                                     alt="Hospital" />

                                <div class="carousel-caption">
                                    <h3>Advanced Technology</h3>
                                    <p>Modern equipment and innovative treatment.</p>
                                </div>
                            </div>

                            <!-- Slide 2 -->
                            <div class="carousel-item">
                                <img src="https://images.unsplash.com/photo-1538108149393-fbbd81895907?auto=format&fit=crop&w=900&q=80"
                                     class="d-block w-100 hero-slide-img"
                                     alt="Doctors" />

                                <div class="carousel-caption">
                                    <h3>Expert Doctors</h3>
                                    <p>Experienced specialists in every field.</p>
                                </div>
                            </div>

                            <!-- Slide 3 -->
                            <div class="carousel-item">
                                <img src="https://images.unsplash.com/photo-1584515933487-779824d29309?auto=format&fit=crop&w=900&q=80"
                                     class="d-block w-100 hero-slide-img"
                                     alt="Patient Care" />

                                <div class="carousel-caption">
                                    <h3>Patient-Centered Care</h3>
                                    <p>Your comfort and health come first.</p>
                                </div>
                            </div>

                        </div>
                    </div>

                
</section>

<!-- ================= SERVICES ================= -->
<section class="py-5">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title" data-aos="fade-up">
                Our Medical Services
            </h2>
            <p class="text-muted">
                Comprehensive healthcare for every need.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="100">
                <div class="premium-card text-center h-100">
                    <div class="service-icon">🫀</div>
                    <h4 class="fw-bold mt-3">Cardiology</h4>
                    <p class="text-muted">
                        Heart care and advanced diagnostics.
                    </p>
                </div>
            </div>

            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="200">
                <div class="premium-card text-center h-100">
                    <div class="service-icon">🧠</div>
                    <h4 class="fw-bold mt-3">Neurology</h4>
                    <p class="text-muted">
                        Brain and nervous system treatment.
                    </p>
                </div>
            </div>

            <div class="col-md-4" data-aos="zoom-in" data-aos-delay="300">
                <div class="premium-card text-center h-100">
                    <div class="service-icon">🦴</div>
                    <h4 class="fw-bold mt-3">Orthopedics</h4>
                    <p class="text-muted">
                        Bone and joint specialists.
                    </p>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ================= FEATURED DOCTORS ================= -->
<section class="py-5 bg-white">
    <div class="container">

        <div class="text-center mb-5">
            <h2 class="section-title">Meet Our Specialists</h2>
            <p class="text-muted">
                Experienced doctors dedicated to your health.
            </p>
        </div>

        <div class="row g-4">

            @if (Model.FeaturedDoctors.Any())
            {
                var _defaultImgs = new[] { "/images/default-doctor.png", "/images/default-doctor1.png", "/images/default-doctor2.png" };
                int _doctorIdx = 0;
                foreach (var doctor in Model.FeaturedDoctors)
                {
                    var _defaultImg = _defaultImgs[_doctorIdx % 3];
                    _doctorIdx++;
                    <div class="col-md-4" data-aos="fade-up">
                        <div class="premium-card text-center h-100">

                            <img src="@(string.IsNullOrWhiteSpace(doctor.ImageUrl) ? _defaultImg : doctor.ImageUrl)"
                                 class="doctor-avatar mb-3"
                                 alt="@doctor.FullName" />

                            <h5 class="fw-bold">@doctor.FullName</h5>

                            <p class="text-primary fw-semibold">
                                @doctor.Specialty
                            </p>

                            <p class="text-muted small">
                                @doctor.ExperienceYears years experience
                            </p>

                            <a asp-page="/Doctors/Details"
                               asp-route-slug="@doctor.Slug"
                               class="btn btn-primary rounded-pill px-4 btn-premium">
                                View Profile
                            </a>
                        </div>
                    </div>
                        }
            }
            else
            {
                <div class="col-12">
                    <div class="alert alert-info text-center rounded-4">
                        Doctors will be available soon.
                    </div>
                </div>
            }

        </div>
    </div>
</section>

