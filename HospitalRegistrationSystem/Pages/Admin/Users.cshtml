@page
@model HospitalRegistrationSystem.Pages.Admin.UsersModel

@{
    ViewData["Title"] = "User Management";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">👥 User Management</h1>
            <p class="text-muted mb-0">Manage all registered system users.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">

        <!-- Sol: Yeni user əlavə et -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3">➕ Add New User</h5>

                    <form method="post" asp-page-handler="Add">
                        <div class="mb-3">
                            <label asp-for="NewUser.FullName" class="form-label fw-bold">Full Name</label>
                            <input asp-for="NewUser.FullName" class="form-control shadow-sm" placeholder="John Doe" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewUser.Username" class="form-label fw-bold">Username</label>
                            <input asp-for="NewUser.Username" class="form-control shadow-sm" placeholder="johndoe" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Password</label>
                            <input name="NewUserPassword" type="password" class="form-control shadow-sm" placeholder="••••••••" />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewUser.Role" class="form-label fw-bold">Role</label>
                            <select asp-for="NewUser.Role" class="form-select shadow-sm">
                                <option value="">Select Role</option>
                                <option>Admin</option>
                                <option>Receptionist</option>
                                <option>Doctor</option>
                                <option>Patient</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold rounded-pill">
                            Save User
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Sağ: Mövcud istifadəçilər -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body">
                    <h5 class="fw-bold mb-3">📋 Existing Users</h5>

                    <!-- Search -->
                    <div class="mb-3">
                        <input type="text" id="userSearch" class="form-control"
                               placeholder="🔍 Search by name or username..." />
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="usersTable">
                            <thead class="table-light">
                                <tr>
                                    <th>Full Name</th>
                                    <th>Username</th>
                                    <th>Role</th>
                                    <th>Created</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var user in Model.Users)
                                {
                                    <tr>
                                        <td class="fw-semibold">@user.FullName</td>
                                        <td>
                                            <code>@user.Username</code>
                                        </td>
                                        <td>
                                            @if (user.Role == "Admin")
                                            {
                                                <span class="badge bg-danger px-3 py-2">Admin</span>
                                            }
                                            else if (user.Role == "Doctor")
                                            {
                                                <span class="badge bg-success px-3 py-2">Doctor</span>
                                            }
                                            else if (user.Role == "Receptionist")
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-2">Receptionist</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-primary px-3 py-2">Patient</span>
                                            }
                                        </td>
                                        <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                                        <td>
                                            <div class="d-flex gap-1 flex-wrap">
                                                @if (user.Role == "Patient" && user.PatientId.HasValue)
                                                {
                                                    <a asp-page="/Patients/Details"
                                                       asp-route-id="@user.PatientId"
                                                       class="btn btn-sm btn-outline-info rounded-pill">
                                                        <i class="fa-solid fa-user-injured me-1"></i> Record
                                                    </a>
                                                }

                                                <!-- Reset Password -->
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-warning rounded-pill"
                                                        data-bs-toggle="modal"
                                                        data-bs-target="#resetPwModal"
                                                        data-userid="@user.Id"
                                                        data-username="@user.Username">
                                                    <i class="fa-solid fa-key me-1"></i> Password
                                                </button>

                                                <!-- Delete (Admin-ı silmək olmaz) -->
                                                @if (user.Username != User.Identity!.Name)
                                                {
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-danger rounded-pill"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#deleteUserModal"
                                                            data-userid="@user.Id"
                                                            data-username="@user.Username"
                                                            data-fullname="@user.FullName">
                                                        <i class="fa-solid fa-trash me-1"></i> Delete
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                                                        Current User
                                                    </span>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (!Model.Users.Any())
                    {
                        <div class="alert alert-info mt-3 mb-0">No users found.</div>
                    }

                    <!-- User count -->
                    <div class="mt-3 text-muted small">
                        Total: <strong>@Model.Users.Count</strong> users
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteUserModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold text-danger">🗑️ Delete User</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete user <strong id="deleteUserName"></strong>?</p>
                <p class="text-muted small mb-0">
                    This action cannot be undone. The patient record (if any) will be preserved.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                <form method="post" asp-page-handler="Delete" id="deleteUserForm">
                    <input type="hidden" name="userId" id="deleteUserId" />
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Reset Password Modal -->
<div class="modal fade" id="resetPwModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow-lg">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold">🔑 Reset Password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form method="post" asp-page-handler="ResetPassword">
                <div class="modal-body">
                    <p>Reset password for: <strong id="resetPwUsername"></strong></p>
                    <input type="hidden" name="userId" id="resetPwUserId" />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">New Password</label>
                        <input type="password" name="newPassword" class="form-control" minlength="6" required />
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary rounded-pill" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Delete modal
        document.getElementById('deleteUserModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('deleteUserId').value = btn.getAttribute('data-userid');
            document.getElementById('deleteUserName').textContent =
                btn.getAttribute('data-fullname') + ' (' + btn.getAttribute('data-username') + ')';
        });

        // Reset password modal
        document.getElementById('resetPwModal').addEventListener('show.bs.modal', function (e) {
            var btn = e.relatedTarget;
            document.getElementById('resetPwUserId').value = btn.getAttribute('data-userid');
            document.getElementById('resetPwUsername').textContent = btn.getAttribute('data-username');
        });

        // Search
        document.getElementById('userSearch').addEventListener('input', function () {
            var filter = this.value.toLowerCase();
            var rows = document.querySelectorAll('#usersTable tbody tr');
            rows.forEach(function (row) {
                var text = row.textContent.toLowerCase();
                row.style.display = text.includes(filter) ? '' : 'none';
            });
        });
    </script>
}
